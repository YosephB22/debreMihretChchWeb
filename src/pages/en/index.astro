---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getLocaleFromUrl } from "@js/localeUtils";
import { useTranslations, getLocalizedRoute } from "@js/translationUtils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<BaseLayout title={t("home")} description={t("home")}>
	<section style="padding: 8rem 1rem; text-align: center;">
		<h1>{t("home")}</h1>
		<p>Your new site is ready. Start building!</p>
		<a href={getLocalizedRoute(locale, "/contact")} class="cs-button-solid">{t("contact")}</a>
	</section>
</BaseLayout>
