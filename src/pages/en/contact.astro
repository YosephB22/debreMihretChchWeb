---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getLocaleFromUrl } from "@js/localeUtils";
import { useTranslations } from "@js/translationUtils";
import { BUSINESS } from "@data/client";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<BaseLayout title={t("contact:title")} description={t("contact:description")}>

	<section id="page-header">
		<div class="cs-container">
			<span class="cs-topper">{t("contact:topper")}</span>
			<h1 class="cs-title">{t("contact:heading")}</h1>
			<p class="cs-text">{t("contact:p")}</p>
		</div>
	</section>

	<section id="contact-content">
		<div class="cs-container">
			<div class="contact-grid">
				<div class="contact-card">
					<h2>{t("contact:address")}</h2>
					<p>
						{BUSINESS.address.lineOne}<br />
						{BUSINESS.address.lineTwo}<br />
						{BUSINESS.address.city} {BUSINESS.address.state}<br />
						{BUSINESS.address.country}
					</p>
					{BUSINESS.address.mapLink && (
						<a href={BUSINESS.address.mapLink} target="_blank" rel="noopener" class="cs-button-solid">
							{t("contact:directions")}
						</a>
					)}
				</div>

				{(BUSINESS.email || BUSINESS.phoneForTel) && (
					<div class="contact-card">
						{BUSINESS.email && (
							<div class="contact-item">
								<h2>{t("contact:email")}</h2>
								<a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
							</div>
						)}
						{BUSINESS.phoneForTel && (
							<div class="contact-item">
								<h2>{t("contact:phone")}</h2>
								<a href={`tel:${BUSINESS.phoneForTel}`}>{BUSINESS.phoneFormatted}</a>
							</div>
						)}
					</div>
				)}
			</div>
		</div>
	</section>

</BaseLayout>

<style lang="less">
	#page-header {
		padding: clamp(6rem, 12vw, 10rem) 1rem clamp(2rem, 4vw, 3rem);
		text-align: center;
		background: var(--dark);
		.cs-container { max-width: (800/16rem); margin: 0 auto; }
		.cs-topper { color: var(--accent); }
		.cs-title { color: #fff; }
		.cs-text { color: rgba(255, 255, 255, 0.8); }
	}

	#contact-content {
		padding: var(--sectionPadding);
		.cs-container { max-width: (900/16rem); margin: 0 auto; }

		.contact-grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.contact-card {
			padding: 2rem;
			background: var(--medium);
			border-radius: var(--borderRadius);

			h2 { font-size: 1.125rem; color: var(--headerColor); margin-bottom: 1rem; }

			p { color: var(--bodyTextColor); line-height: 1.8; }

			a:not(.cs-button-solid) {
				color: var(--primary);
				text-decoration: none;
				&:hover { text-decoration: underline; }
			}

			.cs-button-solid { margin-top: 1.5rem; }

			.contact-item {
				margin-bottom: 1.5rem;
				&:last-child { margin-bottom: 0; }
			}
		}
	}

	@media only screen and (min-width: 48rem) {
		#contact-content .contact-grid { grid-template-columns: repeat(2, 1fr); }
	}
</style>
