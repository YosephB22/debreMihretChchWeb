---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { filterCollectionByLanguage, getPostSlug } from "@js/localeUtils";
import { useTranslations } from "@js/translationUtils";
import BaseLayout from "@layouts/BaseLayout.astro";
import BlogFullArticle from "@components/BlogFullArticle/BlogFullArticle.astro";
import FeaturedPost from "@components/FeaturedPost/FeaturedPost.astro";
import { getBlogPostingSchema } from "@js/blogPostingSchema";

const LOCALE = "en" as const;

export const getStaticPaths = (async () => {
	const allPosts = await getCollection("blog");
	const posts = filterCollectionByLanguage(allPosts, "en");

	return posts.map((post) => ({
		params: { slug: getPostSlug(post) },
		props: { post },
	}));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const t = useTranslations(LOCALE);

const postUrl = new URL(Astro.url.pathname, Astro.site).href;
const blogSchema = getBlogPostingSchema(post, LOCALE, postUrl);
---

<BaseLayout title={post.data.title} description={post.data.description}>
	<script type="application/ld+json" slot="schema" set:html={JSON.stringify(blogSchema)} />

	<section class="main-content-wrapper">
		<div class="main-content">
			<BlogFullArticle post={post} />
		</div>
		<FeaturedPost />
	</section>
</BaseLayout>

<style lang="less">
	@media only screen and (min-width: 0em) {
		.main-content-wrapper {
			padding: var(--sectionPadding);
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			gap: (50/16em);
		}

		.main-content {
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			row-gap: (50/16em);
		}
	}

	@media only screen and (min-width: 64em) {
		.main-content-wrapper {
			flex-direction: row;
			align-items: flex-start;
		}
	}
</style>
