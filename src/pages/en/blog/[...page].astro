---
import type { GetStaticPaths, Page } from "astro";
import { getCollection } from "astro:content";
import { filterCollectionByLanguage } from "@js/localeUtils";
import { useTranslations } from "@js/translationUtils";
import BaseLayout from "@layouts/BaseLayout.astro";
import BlogPreview from "@components/BlogPreview/BlogPreview.astro";
import Pagination from "@components/Pagination/Pagination.astro";

const LOCALE = "en" as const;

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getCollection("blog");
	const localePosts = filterCollectionByLanguage(allPosts, "en");
	const sortedPosts = localePosts.sort(
		(a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
	);

	return paginate(sortedPosts, { pageSize: 3 });
}) satisfies GetStaticPaths;

const t = useTranslations(LOCALE);
const { page } = Astro.props;
---

<BaseLayout title={t("blog:landing")} description={t("blog:title")}>
	<section id="blog-1144">
		<div class="cs-container">
			<div class="cs-content">
				<div class="cs-content-flex">
					<span class="cs-topper">{t("blog:topper")}</span>
					<h2 class="cs-title">{t("blog:title")}</h2>
				</div>
			</div>
			<ul class="cs-card-group">
				{page.data.map((post) => <BlogPreview post={post} />)}
			</ul>
			<Pagination page={page} />
		</div>
	</section>
</BaseLayout>

<style lang="less">
	@media only screen and (min-width: 0rem) {
		#blog-1144 {
			padding: var(--sectionPadding);
			position: relative;
			z-index: 1;

			.cs-container {
				width: 100%;
				max-width: (784/16rem);
				margin: auto;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: clamp(3rem, 6vw, 4rem);
			}

			.cs-content {
				text-align: left;
				width: 100%;
				display: flex;
				flex-direction: column;
				align-items: flex-start;
			}

			.cs-title {
				max-width: 20ch;
			}

			.cs-card-group {
				width: 100%;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(12, 1fr);
				gap: (20/16rem);
			}
		}
	}

	@media only screen and (min-width: 48rem) {
		#blog-1144 {
			.cs-container {
				max-width: (1280/16rem);
			}

			.cs-content {
				text-align: left;
				flex-direction: row;
				justify-content: space-between;
				align-items: flex-end;
			}

			.cs-title {
				margin: 0;
			}
		}
	}
</style>
