---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getLocaleFromUrl } from "@js/localeUtils";
import { useTranslations, getLocalizedRoute } from "@js/translationUtils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const title = t("notFound.pageNotFound");
---

<BaseLayout title={title} description={title}>
	<section id="int-hero">
		<h1>{title}</h1>
		<a href={getLocalizedRoute(locale, "/")} class="cs-button-solid">{t("notFound.linkText")}</a>
	</section>
</BaseLayout>

<style lang="less">
	#int-hero {
		height: 100dvh;
		padding-top: 5em;
		padding-block-end: 1em;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		position: relative;
		z-index: 1;
		text-align: center;

		h1 {
			font-size: var(--headerFontSize);
		}
	}

	.cs-button-solid {
		margin-top: 4em;
	}

	@media only screen and (min-width: 64em) {
		#int-hero {
			padding-top: 12em;
			padding-block-end: 2em;
		}
	}
</style>
