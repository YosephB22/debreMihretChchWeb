---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getLocaleFromUrl } from "@js/localeUtils";
import { useTranslations } from "@js/translationUtils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

type ScheduleItem = { day: string; name: string; time: string; description: string };
type FastingItem = { name: string; period: string; description: string };
type FeastItem = { name: string; date: string };
type StGabrielDate = { name: string; description: string };

const scheduleItems = t<ScheduleItem[]>("services:schedule.items");
const fastingItems = t<FastingItem[]>("services:fasting.items");
const stGabrielDates = t<StGabrielDate[]>("services:feasts.stGabriel.dates");
const feastProgramItems = t<string[]>("services:feasts.stGabriel.feastProgram.items");
const otherFeasts = t<FeastItem[]>("services:feasts.other");
---

<BaseLayout title={t("services:title")} description={t("services:description")}>

	<section id="page-header">
		<div class="cs-container">
			<span class="cs-topper">{t("services:schedule.topper")}</span>
			<h1 class="cs-title">{t("services:schedule.title")}</h1>
		</div>
	</section>

	<!-- Schedule -->
	<section id="schedule">
		<div class="cs-container">
			<div class="schedule-grid">
				{scheduleItems.map((item) => (
					<div class="schedule-card">
						<h3>{item.day}</h3>
						<p class="schedule-name">{item.name}</p>
						<p class="schedule-time">{item.time}</p>
						<p class="schedule-desc">{item.description}</p>
					</div>
				))}
			</div>
			<p class="cs-text note">{t("services:schedule.note")}</p>
		</div>
	</section>

	<!-- Fasting -->
	<section id="fasting">
		<div class="cs-container">
			<span class="cs-topper">{t("services:fasting.topper")}</span>
			<h2 class="cs-title">{t("services:fasting.title")}</h2>
			<p class="cs-text">{t("services:fasting.p")}</p>
			<div class="fasting-grid">
				{fastingItems.map((item) => (
					<div class="fasting-card">
						<h3>{item.name}</h3>
						<p class="fasting-period">{item.period}</p>
						<p class="cs-text">{item.description}</p>
					</div>
				))}
			</div>
			<p class="cs-text note">{t("services:fasting.weekly")}</p>
		</div>
	</section>

	<!-- Feast of St. Gabriel & Calendar -->
	<section id="feasts">
		<div class="cs-container">
			<span class="cs-topper">{t("services:feasts.topper")}</span>
			<h2 class="cs-title">{t("services:feasts.title")}</h2>

			<!-- St. Gabriel featured -->
			<div class="st-gabriel">
				<h3>{t("services:feasts.stGabriel.title")}</h3>
				<p class="cs-text">{t("services:feasts.stGabriel.p1")}</p>
				<p class="cs-text">{t("services:feasts.stGabriel.p2")}</p>
				<div class="gabriel-dates">
					{stGabrielDates.map((d) => (
						<div class="gabriel-date-card">
							<span class="gabriel-date-name">{d.name}</span>
							<span class="gabriel-date-desc">{d.description}</span>
						</div>
					))}
				</div>
				<div class="feast-program">
					<h4>{t("services:feasts.stGabriel.feastProgram.title")}</h4>
					<p class="cs-text">{t("services:feasts.stGabriel.feastProgram.p")}</p>
					<ul>
						{feastProgramItems.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>
				<p class="cs-text monthly">{t("services:feasts.stGabriel.monthly")}</p>
			</div>

			<!-- Other feasts -->
			<h3 class="other-feasts-title">{t("services:feasts.topper")}</h3>
			<div class="feast-grid">
				{otherFeasts.map((item) => (
					<div class="feast-card">
						<span class="feast-name">{item.name}</span>
						<span class="feast-date">{item.date}</span>
					</div>
				))}
			</div>
			<p class="cs-text note">{t("services:feasts.note")}</p>
		</div>
	</section>

	<!-- Sunday School -->
	<section id="sunday-school">
		<div class="cs-container">
			<span class="cs-topper">{t("services:sundaySchool.topper")}</span>
			<h2 class="cs-title">{t("services:sundaySchool.title")}</h2>
			<p class="cs-text">{t("services:sundaySchool.p")}</p>
			<a href={t("services:sundaySchool.linkUrl")} class="cs-button-solid">{t("services:sundaySchool.linkText")}</a>
		</div>
	</section>

</BaseLayout>

<style lang="less">
	#page-header {
		padding: clamp(5rem, 10vw, 8rem) 1.25rem clamp(2rem, 4vw, 3rem);
		text-align: center;
		background: var(--dark);
		.cs-container { max-width: (800/16rem); margin: 0 auto; }
		.cs-topper { color: var(--accent); }
		.cs-title { color: #fff; }
	}

	#schedule {
		padding: var(--sectionPadding);
		.cs-container { max-width: (1280/16rem); margin: 0 auto; }

		.schedule-grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: 1.5rem;
			justify-content: center;
		}

		.schedule-card {
			padding: 2rem;
			background: var(--medium);
			border-radius: var(--borderRadius);
			border-left: 4px solid var(--primary);

			h3 { font-size: 1.25rem; color: var(--primary); margin-bottom: 0.5rem; }
			.schedule-name { font-weight: 600; color: var(--headerColor); margin-bottom: 0.25rem; }
			.schedule-time { font-weight: 500; color: var(--accent); margin-bottom: 0.5rem; }
			.schedule-desc { color: var(--bodyTextColor); font-size: 0.9375rem; }
		}
	}

	#fasting {
		padding: var(--sectionPadding);
		background: var(--medium);
		text-align: center;

		.cs-container { max-width: (1280/16rem); margin: 0 auto; }

		.cs-text { max-width: (700/16rem); margin: 0 auto 2rem; }

		.fasting-grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: 1.5rem;
			text-align: left;
		}

		.fasting-card {
			padding: 1.5rem;
			background: #fff;
			border-radius: var(--borderRadius);

			h3 { font-size: 1.125rem; color: var(--headerColor); margin-bottom: 0.25rem; }
			.fasting-period { font-weight: 500; color: var(--primary); margin-bottom: 0.5rem; font-size: 0.9375rem; }
			.cs-text { margin: 0; }
		}
	}

	#feasts {
		padding: var(--sectionPadding);
		text-align: center;

		.cs-container { max-width: (800/16rem); margin: 0 auto; }

		.st-gabriel {
			text-align: left;
			margin: 2rem 0 3rem;
			padding: 1.25rem;
			background: var(--medium);
			border-radius: var(--borderRadius);
			border-left: 4px solid var(--accent);

			h3 {
				font-size: 1.25rem;
				color: var(--accent);
				margin-bottom: 1rem;
			}

			.cs-text { margin-bottom: 1rem; }

			.gabriel-dates {
				display: grid;
				gap: 1rem;
				margin: 1.5rem 0;
			}

			.gabriel-date-card {
				padding: 1rem 1.25rem;
				background: #fff;
				border-radius: var(--borderRadiusSm);
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
			}

			.gabriel-date-name {
				font-weight: 700;
				color: var(--primary);
			}

			.gabriel-date-desc {
				font-size: 0.9375rem;
				color: var(--bodyTextColor);
			}

			.monthly {
				font-style: italic;
				font-weight: 500;
				margin-bottom: 0;
			}

			.feast-program {
				margin-top: 1.5rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--grey);

				h4 { font-size: 1rem; color: var(--headerColor); margin-bottom: 0.5rem; }
				.cs-text { margin-bottom: 0.75rem; }

				ul {
					list-style: none;
					padding: 0;
					li {
						padding: 0.4rem 0 0.4rem 1.25rem;
						position: relative;
						color: var(--bodyTextColor);
						font-size: 0.9375rem;
						&::before {
							content: "•";
							color: var(--accent);
							font-weight: bold;
							position: absolute;
							left: 0;
						}
					}
				}
			}
		}

		.other-feasts-title {
			font-size: 1.125rem;
			color: var(--headerColor);
			margin-bottom: 1rem;
		}

		.feast-grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: 1rem;
			text-align: left;
		}

		.feast-card {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			padding: 1rem 1.25rem;
			background: var(--medium);
			border-radius: var(--borderRadiusSm);

			.feast-name { font-weight: 600; color: var(--headerColor); }
			.feast-date { color: var(--primary); font-weight: 500; font-size: 0.875rem; }
		}
	}

	#sunday-school {
		padding: var(--sectionPadding);
		background: var(--medium);
		text-align: center;

		.cs-container { max-width: (800/16rem); margin: 0 auto; }
		.cs-text { max-width: (700/16rem); margin: 0 auto 2rem; }

		.cs-button-solid {
			display: inline-block;
			margin-top: 1rem;
		}
	}

	.note {
		margin-top: 2rem;
		font-style: italic;
		font-size: 0.9375rem;
		text-align: center;
	}

	@media only screen and (min-width: 48rem) {
		#schedule .schedule-grid { grid-template-columns: repeat(2, 1fr); max-width: (900/16rem); margin: 0 auto; }
		#fasting .fasting-grid { grid-template-columns: repeat(2, 1fr); }
		#feasts .feast-grid { grid-template-columns: repeat(2, 1fr); }
		#feasts .feast-card { flex-direction: row; justify-content: space-between; align-items: center; }
		#feasts .gabriel-dates { grid-template-columns: repeat(2, 1fr); }
		#feasts .st-gabriel { padding: 2rem; }
	}
</style>
