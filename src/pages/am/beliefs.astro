---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader/PageHeader.astro";
import { getLocaleFromUrl } from "@js/localeUtils";
import { useTranslations } from "@js/translationUtils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<BaseLayout title={t("beliefs:title")} description={t("beliefs:description")}>

	<PageHeader topper={t("beliefs:heading")} title={t("beliefs:title")} />

	<section id="beliefs-content">
		<div class="cs-container">
			<p class="cs-text intro">{t("beliefs:intro")}</p>
			<div class="beliefs-grid">
				<div class="beliefs-card">
					<h2>{t("beliefs:holyTrinity.title")}</h2>
					<p class="cs-text">{t("beliefs:holyTrinity.body")}</p>
				</div>

				<div class="beliefs-card">
					<h2>{t("beliefs:sacraments.title")}</h2>
					<p class="cs-text">{t("beliefs:sacraments.body")}</p>
				</div>

				<div class="beliefs-card">
					<h2>{t("beliefs:scripture.title")}</h2>
					<p class="cs-text">{t("beliefs:scripture.body")}</p>
				</div>

				<div class="beliefs-card">
					<h2>{t("beliefs:saints.title")}</h2>
					<p class="cs-text">{t("beliefs:saints.body")}</p>
				</div>

				<div class="beliefs-card">
					<h2>{t("beliefs:fasting.title")}</h2>
					<p class="cs-text">{t("beliefs:fasting.body")}</p>
				</div>
			</div>
		</div>
	</section>

</BaseLayout>

<style lang="less">

	#beliefs-content {
		padding: var(--sectionPadding);
		.cs-container { max-width: (1280/16rem); margin: 0 auto; }

		.intro {
			max-width: (700/16rem);
			margin: 0 auto 2rem;
			text-align: center;
		}

		.beliefs-grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.beliefs-card {
			padding: 2rem;
			background: var(--medium);
			border-radius: var(--borderRadius);
			border-left: 4px solid var(--primary);

			h2 { font-size: 1.25rem; color: var(--primary); margin-bottom: 0.75rem; }
			.cs-text { color: var(--bodyTextColor); font-size: 0.9375rem; }
		}
	}

	@media only screen and (min-width: 48rem) {
		#beliefs-content .beliefs-grid { grid-template-columns: repeat(2, 1fr); }
	}
</style>
