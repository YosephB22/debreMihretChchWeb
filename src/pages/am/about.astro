---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader/PageHeader.astro";
import { getLocaleFromUrl } from "@js/localeUtils";
import { useTranslations } from "@js/translationUtils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<BaseLayout title={t("about:title")} description={t("about:description")}>

	<PageHeader topper={t("about:history.topper")} title={t("about:history.title")} />

	<section id="content">
		<div class="cs-container">
			<div class="content-block">
				<p class="cs-text">{t("about:history.p1")}</p>
				<p class="cs-text">{t("about:history.p2")}</p>
			</div>

			<div class="content-block">
				<span class="cs-topper">{t("about:faith.topper")}</span>
				<h2 class="cs-title">{t("about:faith.title")}</h2>
				<p class="cs-text">{t("about:faith.p1")}</p>
				<p class="cs-text">{t("about:faith.p2")}</p>
				<p class="cs-text">{t("about:faith.p3")}</p>
				<p class="cs-text">{t("about:faith.p4")}</p>
			</div>

			<div class="content-block">
				<span class="cs-topper">{t("about:clergy.topper")}</span>
				<h2 class="cs-title">{t("about:clergy.title")}</h2>
				<p class="cs-text">{t("about:clergy.placeholder")}</p>
			</div>
		</div>
	</section>

</BaseLayout>

<style lang="less">

	#content {
		padding: var(--sectionPadding);
		.cs-container { max-width: (800/16rem); margin: 0 auto; }

		.content-block {
			margin-bottom: 3rem;

			&:last-child { margin-bottom: 0; }

			.cs-text {
				margin-bottom: 1rem;
				&:last-child { margin-bottom: 0; }
			}
		}
	}
</style>
