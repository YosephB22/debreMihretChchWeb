---
import { locales, defaultLocale } from "@config/siteSettings";
---

<script is:inline define:vars={{ locales, defaultLocale }}>
  if (!localStorage.getItem("locale-preference")) {
    var lang = (navigator.languages && navigator.languages[0]) || navigator.language;
    if (lang) {
      var match = locales.find(function(l) { return lang.startsWith(l); });
      if (match) {
        window.location.replace("/" + match + "/");
      } else {
        window.location.replace("/" + defaultLocale + "/");
      }
    }
  }
</script>
