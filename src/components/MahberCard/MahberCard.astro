---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  description: string;
  schedule: string;
  contactName: string;
  contactEmail?: string;
  image?: ImageMetadata;
}

const { name, description, schedule, contactName, contactEmail, image } = Astro.props;
---

<li class="cs-item">
  {image && (
    <div class="cs-picture">
      <Image
        src={image}
        alt={name}
        width={400}
        height={300}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  <div class="cs-flex">
    <h3 class="cs-h3">{name}</h3>
    <p class="cs-item-text">{description}</p>
    <div class="cs-slot">
      <slot />
    </div>
    <div class="cs-info">
      {schedule && (
        <span class="cs-schedule">
          <img
            class="cs-icon"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Icons/calendar.svg"
            alt="schedule"
            width="20"
            height="20"
            aria-hidden="true"
            loading="lazy"
            decoding="async"
          />
          {schedule}
        </span>
      )}
      {contactName && (
        <span class="cs-contact">
          <img
            class="cs-icon"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Icons/user.svg"
            alt="contact"
            width="20"
            height="20"
            aria-hidden="true"
            loading="lazy"
            decoding="async"
          />
          {contactName}
        </span>
      )}
      {contactEmail && (
        <a href={`mailto:${contactEmail}`} class="cs-email">
          <img
            class="cs-icon"
            src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Icons/email.svg"
            alt="email"
            width="20"
            height="20"
            aria-hidden="true"
            loading="lazy"
            decoding="async"
          />
          {contactEmail}
        </a>
      )}
    </div>
  </div>
</li>

<style lang="less">
  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    .cs-item {
      text-align: left;
      list-style: none;
      border-radius: (16/16rem);
      overflow: hidden;
      background-color: #f7f7f7;
      border: 1px solid #e8e8e8;
      display: flex;
      flex-direction: column;
      position: relative;
      z-index: 1;
      transition:
        box-shadow 0.3s,
        transform 0.3s;

      &:hover {
        box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
      }
    }

    .cs-picture {
      width: 100%;
      height: (200/16rem);
      background-color: var(--dark);
      border-bottom: 4px solid var(--primary);
      overflow: hidden;
      display: block;
      flex: none;
      position: relative;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
    }

    .cs-flex {
      height: 100%;
      padding: (24/16rem);
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .cs-h3 {
      font-size: (20/16rem);
      text-align: inherit;
      line-height: 1.2em;
      font-weight: 700;
      color: var(--headerColor);
      margin: 0 0 (12/16rem) 0;
    }

    .cs-item-text {
      font-size: clamp(0.875rem, 1.5vw, 1rem);
      line-height: 1.5em;
      text-align: inherit;
      margin: 0 0 (20/16rem);
      color: var(--bodyTextColor);
    }

    .cs-slot {
      width: 100%;
      margin-bottom: (20/16rem);

      &:empty {
        display: none;
        margin: 0;
      }

      :global(h2),
      :global(h3) {
        font-size: (16/16rem);
        font-weight: 700;
        color: var(--headerColor);
        margin: 0 0 (8/16rem) 0;
      }

      :global(ul) {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: (10/16rem);
      }

      :global(li) {
        font-size: (14/16rem);
        line-height: 1.5em;
        color: var(--bodyTextColor);
        padding: (10/16rem) (12/16rem);
        background: #fff;
        border-radius: (6/16rem);
        border-left: 3px solid var(--primary);
        white-space: pre-line;
      }

      :global(em) {
        color: var(--accent);
        font-style: normal;
        font-weight: 500;
      }

      :global(strong) {
        color: var(--headerColor);
      }

      :global(p) {
        font-size: (14/16rem);
        line-height: 1.5em;
        color: var(--bodyTextColor);
        margin: 0 0 (8/16rem) 0;
      }
    }

    .cs-info {
      display: flex;
      flex-direction: column;
      gap: (8/16rem);
      margin-top: auto;
    }

    .cs-schedule,
    .cs-contact,
    .cs-email {
      font-size: (14/16rem);
      line-height: 1.5em;
      color: var(--bodyTextColor);
      display: flex;
      align-items: center;
      gap: (8/16rem);
    }

    .cs-schedule {
      color: var(--accent);
      font-weight: 500;
    }

    .cs-email {
      color: var(--primary);
      text-decoration: none;
      font-weight: 700;

      &:hover {
        text-decoration: underline;
      }
    }

    .cs-icon {
      width: (20/16rem);
      height: auto;
      flex: none;
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    .cs-item {
      /* Cards fill grid cells defined by parent */
    }
  }
</style>
