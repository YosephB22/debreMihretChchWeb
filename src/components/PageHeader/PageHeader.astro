---
type Props = {
	topper?: string;
	title: string;
	text?: string;
};

const { topper, title, text } = Astro.props;
---

<section id="page-header">
	<div class="cs-container">
		{topper && <span class="cs-topper">{topper}</span>}
		<h1 class="cs-title">{title}</h1>
		{text && <p class="cs-text">{text}</p>}
	</div>
</section>

<style lang="less">
	#page-header {
		padding: clamp(5rem, 10vw, 8rem) 1.25rem clamp(2rem, 4vw, 3rem);
		text-align: center;
		background: var(--dark);

		.cs-container {
			max-width: 50rem;
			margin: 0 auto;
		}

		.cs-topper {
			color: var(--primaryLight);
		}

		.cs-title {
			color: #fff;
		}

		.cs-text {
			color: rgba(255, 255, 255, 0.82);
			max-width: 37.5rem;
			margin: 0.75rem auto 0;
		}
	}
</style>
