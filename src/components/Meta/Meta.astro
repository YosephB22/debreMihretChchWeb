---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { BUSINESS, OG, SITE } from "@data/client";
import { getLocalBusinessSchema } from "@js/localBusinessSchema.js";
import { getLocaleFromUrl } from "@js/localeUtils";
import { getLocalizedPathname } from "@js/translationUtils";
import { locales, localeMap } from "@config/siteSettings";

type Props = {
	title?: string;
	description?: string;
	heroImage?: ImageMetadata | undefined;
};

const { title = SITE.title, description = SITE.description, heroImage } = Astro.props;

const localBusinessSchema = getLocalBusinessSchema(Astro.url.origin);
const canonical = Astro.url.href;

const locale = getLocaleFromUrl(Astro.url);
const isLandingPage = Astro.url.pathname === "/" || Astro.url.pathname === `/${locale}/`;

const pageTitle = isLandingPage
	? `${title} | ${BUSINESS.name} | ${BUSINESS.address.city} ${BUSINESS.address.state}`
	: `${title} | ${BUSINESS.name}`;

const hrefLangLinks = await Promise.all(
	locales.map(async (l) => ({
		hreflang: localeMap[l],
		href: new URL(await getLocalizedPathname(l, Astro.url), Astro.site).href,
	}))
);

let socialImage: string;

if (heroImage) {
	const optimizedImage = await getImage({
		src: heroImage,
		width: 1200,
		height: 600,
		format: "webp",
	});
	socialImage = Astro.url.origin + optimizedImage.src;
} else {
	socialImage = Astro.url.origin + OG.image;
}

const socialImageType = socialImage.endsWith(".webp") ? "image/webp" : "image/jpeg";
---

<meta charset="utf-8" />
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

<slot name="schema" />

<title>{pageTitle}</title>

{hrefLangLinks.map(({ hreflang, href }) => (
	<link rel="alternate" hreflang={hreflang} href={href} />
))}
<link rel="alternate" hreflang="x-default" href={hrefLangLinks[0]?.href} />

<!-- Open Graph -->
<meta property="og:locale" content={OG.locale} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="600" />
<meta property="og:image:type" content={socialImageType} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<!-- Favicons -->
<link rel="icon" type="image/png" href="/assets/favicons/favicon-96x96.png" sizes="96x96"/>
<link rel="icon" type="image/svg+xml" href="/assets/favicons/favicon.svg"/>
<link rel="shortcut icon" href="/assets/favicons/favicon.ico"/>
<link rel="apple-touch-icon" sizes="180x180" href="/assets/favicons/apple-touch-icon.png"/>
<meta name="apple-mobile-web-app-title" content={BUSINESS.nameShort}/>
<link rel="manifest" href="/assets/favicons/site.webmanifest"/>
