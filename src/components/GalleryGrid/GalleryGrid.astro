---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

type Props = {
	emptyText: string;
	ariaClose: string;
	ariaPrev: string;
	ariaNext: string;
	ariaLightboxAlt: string;
};

const { emptyText, ariaClose, ariaPrev, ariaNext, ariaLightboxAlt } = Astro.props;

// Dynamically import all images from the gallery folder.
// import.meta.glob is the official Astro/Vite recipe for this pattern.
// New photos added to this folder are picked up automatically at build time.
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/images/gallery/*.{jpg,jpeg,png,webp,avif,gif}",
	{ eager: true }
);
const images = Object.values(imageModules).map((m) => m.default);
---

<section id="gallery-grid">
	<div class="cs-container">
		{images.length === 0 ? (
			<p class="cs-text empty">{emptyText}</p>
		) : (
			<>
				<ul class="gallery-grid" role="list">
					{images.map((img, i) => (
						<li>
							<button
								class="gallery-thumb"
								data-index={i}
								aria-label={`${ariaLightboxAlt} ${i + 1}`}
								type="button"
							>
								<Image
									src={img}
									alt=""
									width={600}
									height={400}
									loading="lazy"
									decoding="async"
									class="thumb-img"
								/>
							</button>
						</li>
					))}
				</ul>

				<dialog
					id="gallery-lightbox"
					aria-label={ariaLightboxAlt}
					aria-modal="true"
				>
					<div class="lightbox-inner">
						<button
							id="lb-close"
							class="lb-btn lb-close"
							aria-label={ariaClose}
							type="button"
						>
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
								<line x1="18" y1="6" x2="6" y2="18"/>
								<line x1="6" y1="6" x2="18" y2="18"/>
							</svg>
						</button>
						<button
							id="lb-prev"
							class="lb-btn lb-prev"
							aria-label={ariaPrev}
							type="button"
						>
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<polyline points="15 18 9 12 15 6"/>
							</svg>
						</button>
						<img
							id="lb-img"
							src=""
							alt={ariaLightboxAlt}
							class="lb-image"
							width="1200"
							height="800"
						/>
						<button
							id="lb-next"
							class="lb-btn lb-next"
							aria-label={ariaNext}
							type="button"
						>
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<polyline points="9 18 15 12 9 6"/>
							</svg>
						</button>
						<div id="lb-counter" class="lb-counter" aria-live="polite"></div>
					</div>
				</dialog>
			</>
		)}
	</div>
</section>

{/* Inline script so it re-runs after every ClientRouter navigation via astro:page-load */}
<script is:inline>
	document.addEventListener("astro:page-load", () => {
		const dialog = document.getElementById("gallery-lightbox");
		if (!dialog) return;

		const lbImg = document.getElementById("lb-img");
		const lbCounter = document.getElementById("lb-counter");
		const thumbs = Array.from(document.querySelectorAll(".gallery-thumb"));
		let current = 0;

		function show(index) {
			const thumb = thumbs[index];
			if (!thumb) return;
			const img = thumb.querySelector("img");
			lbImg.src = img.src;
			lbImg.srcset = img.srcset || "";
			lbImg.alt = img.alt || "";
			lbCounter.textContent = `${index + 1} / ${thumbs.length}`;
			current = index;
		}

		function open(index) {
			show(index);
			dialog.showModal();
		}

		function close() {
			dialog.close();
		}

		function prev() {
			show((current - 1 + thumbs.length) % thumbs.length);
		}

		function next() {
			show((current + 1) % thumbs.length);
		}

		thumbs.forEach((btn, i) => {
			btn.addEventListener("click", () => open(i));
		});

		document.getElementById("lb-close").addEventListener("click", close);
		document.getElementById("lb-prev").addEventListener("click", prev);
		document.getElementById("lb-next").addEventListener("click", next);

		// Close on backdrop click (outside the lightbox-inner)
		dialog.addEventListener("click", (e) => {
			const inner = dialog.querySelector(".lightbox-inner");
			if (!inner.contains(e.target)) close();
		});

		// Keyboard: left/right arrows
		dialog.addEventListener("keydown", (e) => {
			if (e.key === "ArrowLeft") prev();
			if (e.key === "ArrowRight") next();
		});
	});
</script>

<style lang="less">
	#gallery-grid {
		padding: var(--sectionPadding);

		.cs-container {
			max-width: (1280/16rem);
			margin: 0 auto;
		}

		.empty {
			text-align: center;
			font-style: italic;
			color: var(--bodyTextColor);
		}
	}

	.gallery-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
	}

	.gallery-thumb {
		display: block;
		width: 100%;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
		border-radius: var(--borderRadius);
		overflow: hidden;
		position: relative;

		.thumb-img {
			width: 100%;
			height: 14rem;
			object-fit: cover;
			display: block;
			border-radius: var(--borderRadius);
			transition: transform 0.25s ease, filter 0.25s ease;
		}

		&:hover .thumb-img,
		&:focus-visible .thumb-img {
			transform: scale(1.03);
			filter: brightness(1.08);
		}

		&:focus-visible {
			outline: 3px solid var(--primary);
			outline-offset: 2px;
		}
	}

	/* Lightbox dialog */
	#gallery-lightbox {
		padding: 0;
		border: none;
		border-radius: var(--borderRadius);
		background: transparent;
		max-width: 100vw;
		max-height: 100vh;
		width: 100%;
		height: 100%;

		&::backdrop {
			background: rgba(11, 36, 73, 0.92);
			backdrop-filter: blur(4px);
		}
	}

	.lightbox-inner {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100vw;
		height: 100vh;
	}

	.lb-image {
		max-width: 90vw;
		max-height: 85vh;
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: var(--borderRadius);
		display: block;
	}

	.lb-btn {
		position: absolute;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: none;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.15);
		color: #fff;
		cursor: pointer;
		transition: background 0.2s ease;
		backdrop-filter: blur(4px);

		&:hover {
			background: rgba(255, 255, 255, 0.3);
		}

		&:focus-visible {
			outline: 2px solid #fff;
			outline-offset: 2px;
		}
	}

	.lb-close {
		top: 1.25rem;
		right: 1.25rem;
	}

	.lb-prev {
		left: 1.25rem;
		top: 50%;
		transform: translateY(-50%);
	}

	.lb-next {
		right: 1.25rem;
		top: 50%;
		transform: translateY(-50%);
	}

	.lb-counter {
		position: absolute;
		bottom: 1.25rem;
		left: 50%;
		transform: translateX(-50%);
		color: rgba(255, 255, 255, 0.75);
		font-size: 0.875rem;
		letter-spacing: 0.05em;
	}

	@media only screen and (min-width: 36rem) {
		.gallery-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media only screen and (min-width: 64rem) {
		.gallery-grid {
			grid-template-columns: repeat(3, 1fr);
		}
		.gallery-thumb .thumb-img {
			height: 16rem;
		}
	}

	@media only screen and (min-width: 80rem) {
		.gallery-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
